# Copy this file to ".streamlit/secrets.toml" and fill in your keys.
# ".streamlit/secrets.toml" is git-ignored and must NEVER be committed.
#
# Streamlit exposes these via st.secrets[...]. The app also falls back to
# environment variables (.env) when a secret is not set here.

PROVIDER = "openai"

OPENAI_API_KEY = ""
OPENAI_MODEL = "gpt-4o"

GOOGLE_API_KEY = ""
GEMINI_MODEL = "gemini-1.5-flash"
